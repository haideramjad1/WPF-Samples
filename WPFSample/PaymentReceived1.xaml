<Window x:Class="WPFSample.PaymentReceived1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFSample"
        mc:Ignorable="d"
        Title="PaymentReceived1" Height="620" Width="580"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <Border>
        <Grid>
            <Border CornerRadius="10"
                BorderThickness ="10"
                Height="150"
                VerticalAlignment="Top"
                    BorderBrush="LightGray"
                    Background="#003187">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Column="3"
                          Grid.Row="0">
                        <Button x:Name="Close_Button" 
                            Margin="0,3,3,8"
                            Template="{StaticResource ImageButtonTemplate}"
                            Tag="{StaticResource CloseButtonImageBrush}"
                            Click="Close_Button_Click">
                        </Button>
                    </Grid>

                    <Grid Grid.Column="0"
                      Width="35"
                      Margin="0,4,0,0"
                      Grid.Row="0">
                        <!--<Image x:Name="FormPicture" 
                       Source="pack://application:,,,/Resources/Customer_Image.png"/>-->
                    </Grid>

                    <Grid Grid.Column="1"
                  Grid.Row="0">
                        <Border CornerRadius="10">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                            </Border.Effect>

                            <Grid >
                                <TextBlock x:Name="FormTitle" 
                                       Text="Payment Received"
                                       FontSize="30" 
                                       Padding="5,0,0,0"
                                       FontWeight="Medium"
                                       Foreground="White"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>



            <Border CornerRadius="30"
                    Background="White"
                    Margin="40,80,40,10">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="1" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="1.3*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40*"/>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Style="{StaticResource LeftAlignedTextBlock}" Height="31">
                            <Run Text="Customer"/>
                            <Run Text="*" Foreground="Red"/>
                            </TextBlock>
                            <TextBlock Text=": "
                                   Style="{StaticResource RightAlignedTextBlock}" Height="31">
                            </TextBlock>

                        </Grid>
                        <Grid Grid.Row="0"
                      Grid.Column="1" >

                            <TextBox x:Name="Name_TextEdit"
                                 Style="{StaticResource CommonTextBoxStyle}" Margin="10,0,10,0"
                                 TextChanged="ForPlaceHolder_TextChanged"
                                 MouseDoubleClick="Alphabetic_Keyboard_Click">
                            </TextBox>

                            <TextBlock Name="NameTextBlock" 
                               Text=" Customer" 
                               Style="{StaticResource PlaceholderTextBlockStyle}">
                            </TextBlock>

                            <Button x:Name="MessageInfo1"
                                Click="MessageInformation_Click"
                                Visibility="Hidden"
                                Style="{StaticResource RoundedTransparentButtonStyle}">
                                <Image Source="pack://application:,,,/Resources/InformationAlert.png"/>

                            </Button>

                            <Popup x:Name="InfoPopup1" 
                               Style="{StaticResource RoundedPopupStyle}">
                                <Border Style="{StaticResource RoundedPopupBorderStyle}">

                                    <TextBlock x:Name="PopupTextBlock1" Text="Default Message"
                                           Style="{StaticResource PopupTextBlockStyle}"/>
                                </Border>
                            </Popup>

                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBlock Style="{StaticResource LeftAlignedTextBlock}" Height="31"
                                       FontSize="22">
                                <Run Text="Credit Balance"/>
                            </TextBlock>
                            <TextBlock Text=": "
                                   Style="{StaticResource RightAlignedTextBlock}" Height="31">
                            </TextBlock>

                        </Grid>
                        <Grid Grid.Row="1"
                      Grid.Column="1">
                            <TextBox x:Name="MobileNo_TextEdit"
                                 Style="{StaticResource CommonTextBoxStyle}" Margin="10,0,10,0"
                                 TextChanged="ForPlaceHolder_TextChanged"
                                 PreviewTextInput="TextEdit_PreviewTextInput"
                                 PreviewKeyDown="TextEdit_PreviewKeyDown"
                                 MouseDoubleClick="Numeric_Keyboard_Click"
                                 MaxLength="12">
                            </TextBox>

                            <TextBlock Name="MobileTextBlock" 
                               Text=" Credit Balance" 
                               Style="{StaticResource PlaceholderTextBlockStyle}">
                            </TextBlock>

                            <Button x:Name="MessageInfo"
                                Click="MessageInformation_Click"
                                Visibility="Hidden"
                                Style="{StaticResource RoundedTransparentButtonStyle}">
                                <Image Source="pack://application:,,,/Resources/InformationAlert.png"/>
                            </Button>

                            <Popup x:Name="InfoPopup" 
                               Style="{StaticResource RoundedPopupStyle}">
                                <Border Style="{StaticResource RoundedPopupBorderStyle}">

                                    <TextBlock x:Name="PopupTextBlock" Text="Default Message"
                                           Style="{StaticResource PopupTextBlockStyle}"/>
                                </Border>
                            </Popup>

                        </Grid>

                        <Grid Grid.Row="2">

                            <TextBlock Style="{StaticResource LeftAlignedTextBlock}" Height="31"
                                       FontSize="20">
                                <Run Text="Amount Received"/>
                                <Run Text="*" Foreground="Red"/>
                            </TextBlock>

                            <TextBlock Text=": "
                           Style="{StaticResource RightAlignedTextBlock}" Height="31">
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Row="2"
                      Grid.Column="1" >
                            <TextBox x:Name="Email_TextEdit"
                                 Style="{StaticResource CommonTextBoxStyle}" Margin="10,0,10,0"
                                 TextChanged="ForPlaceHolder_TextChanged"
                                 MouseDoubleClick="Alphabetic_Keyboard_Click">
                            </TextBox>

                            <TextBlock Name="EmailTextBlock" 
                               Text=" Amount Received" 
                               Style="{StaticResource PlaceholderTextBlockStyle}">
                            </TextBlock>
                        </Grid>

                    </Grid>

                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*"/>
                            <ColumnDefinition Width="100*"/>
                            <ColumnDefinition Width="20*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border CornerRadius="20" Grid.Column="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Color="#696664" Offset="0"/>
                                    <GradientStop Color="LightSteelBlue" Offset="0.5"/>
                                    <GradientStop Color="#696664" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="10*"/>
                                    <RowDefinition Height="60*"/>
                                    <RowDefinition Height="5*"/>
                                    <RowDefinition Height="60*"/>
                                    <RowDefinition Height="5*"/>
                                    <RowDefinition Height="60*"/>
                                    <RowDefinition Height="5*"/>
                                    <RowDefinition Height="60*"/>
                                    <RowDefinition Height="5*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="5,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8*"/>
                                        <ColumnDefinition Width="8*"/>
                                        <ColumnDefinition Width="8*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="Seven_Button" Content="7" Grid.Column="0" 
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                        Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                    <Button x:Name="Eight_Button" Content="8" Grid.Column="1"
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                        Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                    <Button x:Name="Nine_Button" Content="9" Grid.Column="2"
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                        Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                </Grid>

                                <Grid Grid.Row="3"
                                      Grid.Column="1"
                                      Margin="5,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8*"/>
                                        <ColumnDefinition Width="8*"/>
                                        <ColumnDefinition Width="8*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="Four_Button" Content="4" Grid.Column="0" 
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                        Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                    <Button x:Name="Five_Button" Content="5" Grid.Column="1"
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                        Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                    <Button x:Name="Six_Button" Content="6" Grid.Column="2" 
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                        Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                </Grid>

                                <Grid Grid.Row="5"
                                      Grid.Column="1"
                                      Margin="5,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8*"/>
                                        <ColumnDefinition Width="8*"/>
                                        <ColumnDefinition Width="8*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="One_Button" Content="1" Grid.Column="0"
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                                Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                    <Button x:Name="Two_Button" Content="2" Grid.Column="1"
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                                Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                    <Button x:Name="Three_Button" Content="3" Grid.Column="2"
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                                Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                </Grid>

                                <Grid Grid.Row="7"
                                      Grid.Column="1"
                                      Margin="5,0,5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8*"/>
                                        <ColumnDefinition Width="8*"/>
                                        <ColumnDefinition Width="8*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="DoubleZero_Button" Content="00" Grid.Column="0" 
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                        Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                    <Button x:Name="Zero_Button" Content="0" Grid.Column="1"
                                    Style="{StaticResource KeyboardwhiteButtonStyle}"
                                        Foreground="Black"
                                    Click="KeyboardButton_Click"/>

                                    <Button x:Name="Clear_Button" Grid.Column="2" 
                                            Content="Clear"
                                    Style="{StaticResource KeyboardBlackButtonStyle}"
                                    Click="Clear_Button_Click">
                                    </Button>

                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>
                    
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="162*"/>
                            <ColumnDefinition Width="105*"/>
                            <ColumnDefinition Width="105*"/>
                            <ColumnDefinition Width="18*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1">
                            <Button x:Name="Save_Btn" 
                                Content="Pay"
                                Style="{StaticResource GreenButtonStyle}"
                                Click="Save_Btn_Click"
                                Margin="5,10,5,15">
                            </Button>
                        </Grid>

                        <Grid  Grid.Column="2">
                            <Button x:Name="NoBtn" 
                                Content="Close"
                                Style="{StaticResource RedButtonStyle}"
                                Click="Close_Button_Click"
                                Margin="5,10,5,15">
                            </Button>
                        </Grid>

                    </Grid>

                </Grid>

            </Border>
        </Grid>
    </Border>

</Window>
