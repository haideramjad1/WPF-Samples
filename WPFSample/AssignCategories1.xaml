<Window x:Class="WPFSample.AssignCategories1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFSample"
        mc:Ignorable="d"
        Title="AssignCategories1" Height="650" Width="800"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <Window.Resources>
        <!-- ToggleButton for expand/collapse -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Path x:Name="ExpandPath"
                          Fill="Black"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="Data"
                                Value="M 0 4 L 4 0 L 8 4 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeViewItem style with dotted lines and node circles -->
        <Style x:Key="TreeViewItemWithLines" TargetType="TreeViewItem">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Dotted lines and dot node -->
                            <Canvas Grid.Column="0">
                                <!-- Vertical dotted line -->
                                <Line X1="10" Y1="0" X2="10"
                              Y2="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualHeight}"
                              Stroke="Gray"
                              StrokeThickness="1"
                              StrokeDashArray="1,2"/>

                                <!-- Horizontal dotted connector -->
                                <Line X1="10" Y1="12" X2="18" Y2="12"
                              Stroke="Gray"
                              StrokeThickness="1"
                              StrokeDashArray="1,2"/>

                                <!-- Dot node -->
                                <Ellipse Fill="Gray"
                                 Width="4" Height="4"
                                 Canvas.Left="8" Canvas.Top="10"/>
                            </Canvas>

                            <!-- Header + Expander -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton x:Name="Expander"
                                      Style="{StaticResource ExpandCollapseToggleStyle}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                                <ContentPresenter x:Name="Header"
                                          ContentSource="Header"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Margin="2,0"/>
                            </StackPanel>

                            <!-- Children -->
                            <ItemsPresenter Grid.Column="1" x:Name="ItemsHost" Margin="20,2,0,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="false">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border>
        <Grid>
            <Border CornerRadius="10"
            BorderThickness ="10" BorderBrush="LightGray"
            Height="150" Background="#003187"
            VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Column="3"
              Grid.Row="0">
                        <Button x:Name="Close_Button" 
                        Margin="0,3,3,8"
                        Template="{StaticResource ImageButtonTemplate}"
                        Tag="{StaticResource CloseButtonImageBrush}"
                        Click="Close_Button_Click">
                        </Button>
                    </Grid>

                    <!--<Grid Grid.Column="0"
                  Width="35"
                  Margin="0,4,0,0"
                  Grid.Row="0">
                    <Image x:Name="FormPicture" 
                   Source="pack://application:,,,/Resources/Customer_Image.png"/>
                </Grid>-->

                    <Grid Grid.Column="1"
              Grid.Row="0">
                        <Border CornerRadius="10">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                            </Border.Effect>

                            <Grid >
                                <TextBlock x:Name="FormTitle" 
                                   Text="Add Menu Categories"
                                   FontSize="30" 
                                   Padding="5,0,0,0"
                                   FontWeight="Medium"
                                   Foreground="White"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>



            <Border CornerRadius="30"
        Margin="40,80,40,10" Background="White">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="1" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="90"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" x:Name="ParentCategoryRow">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="8*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Column="1"
                          Margin="0,5,0,0">
                            <Grid.ColumnDefinitions >
                                <ColumnDefinition Width="100*"/>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                              Margin="10,0,10,0">
                                <Grid>

                                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource CommonTextBoxStyle}" Margin="10,0,10,0"
                             TextChanged="SearchTextBox_TextChanged">
                                    </TextBox>

                                    <TextBlock Name="PlaceholderTextBlock" 
                               Text=" Search Category..." 
                               FontSize="30" 
                               Style="{StaticResource PlaceholderTextBlockStyle}">
                                    </TextBlock>

                                </Grid>
                            </Grid>

                            <Grid Grid.Column="1"
                              Margin="-20,10,10,10">
                                <Button x:Name="Search_Button" 
                        Grid.Column="1" 
                        Template="{StaticResource ImageButtonTemplate}"
                        Tag="{StaticResource MagnifyButtonImageBrush}">
                                </Button>
                            </Grid>

                        </Grid>
                        
                        <Grid Grid.Row="2"
                              Grid.Column="1">
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">

                                <TreeView x:Name="MyTreeView" Margin="10">

                                    <TreeViewItem Header="Fruits">
                                        <TreeViewItem Header="Apple"/>
                                        <TreeViewItem Header="Banana"/>
                                        <TreeViewItem Header="Orange"/>
                                    </TreeViewItem>


                                    <TreeViewItem Header="Vegetables"/>
                                    <TreeViewItem Header="Carrot"/>
                                    <TreeViewItem Header="Potato"/>
                                    <TreeViewItem Header="Tomato"/>

                                </TreeView>

                            </Grid>
                            
                            <Grid Grid.Column="1">
                                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="90"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="90"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="1">
                                    <Button x:Name="AssignMneuCategory_Btn"
                                            Style="{StaticResource ManagerBlueButtonStyle}"
                                            Click="AssignMneuCategory_Btn_Click">
                                        <TextBlock Text="Add Categories"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                
                                <Grid Grid.Row="3">
                                    <Button x:Name="RemoveAssignCategory_Btn" 
                                            Style="{StaticResource ManagerBlueButtonStyle}"
                                            Click="RemoveAssignCategory_Btn_Click">
                                        <TextBlock Text="Remove Categories"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                
                            </Grid>

                            <Grid Grid.Column="2">

                                <TreeView x:Name="MyTreeView2" ItemContainerStyle="{StaticResource TreeViewItemWithLines}" Margin="10">

                                    <TreeViewItem Header="Fruits">
                                        <TreeViewItem Header="Apple"/>
                                        <TreeViewItem Header="Banana"/>
                                        <TreeViewItem Header="Orange"/>
                                    </TreeViewItem>


                                    <TreeViewItem Header="Vegetables"/>
                                    <TreeViewItem Header="Carrot"/>
                                    <TreeViewItem Header="Potato"/>
                                    <TreeViewItem Header="Tomato"/>

                                </TreeView>

                            </Grid>

                        </Grid>

                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200*"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="10*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1">
                            <Button x:Name="Save_Btn" 
                                Content="Save"
                                Style="{StaticResource GreenButtonStyle}"
                                Click="Save_Btn_Click"
                                Margin="3,20,3,20">
                            </Button>
                        </Grid>

                        <Grid  Grid.Column="3">
                            <Button x:Name="Close_Btn" 
                                Content="Close"
                                Style="{StaticResource RedButtonStyle}"
                                Click="Close_Button_Click"
                                Margin="3,20,3,20">
                            </Button>
                        </Grid>

                    </Grid>

                </Grid>

            </Border>
        </Grid>
    </Border>

</Window>
