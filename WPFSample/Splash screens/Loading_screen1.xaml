        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Title="Loading_screen1" Width="300" Height="300"
        Loaded="Window_Loaded">


    
