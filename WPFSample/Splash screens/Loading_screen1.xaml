    <!-- design no 2 -->

    <!--Glassy Background Panel--><!-- 
    <Border CornerRadius="20" Background="#FF1E3C72" Padding="20" Opacity="0.95">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" >

                 --><!--Spinner Canvas--><!-- 
                <Canvas Width="100" Height="100" Margin="0,0,0,20">
                     --><!--Right Arc--><!-- 
                    <Path StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#90CAF9" Offset="0.0" />
                                <GradientStop Color="#1976D2" Offset="1.0" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="50,10" IsClosed="False">
                                    <ArcSegment Point="90,50"
                                                Size="40,40"
                                                SweepDirection="Clockwise"
                                                IsLargeArc="False"/>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                        <Path.RenderTransform>
                            <RotateTransform x:Name="rotateTransform1" CenterX="50" CenterY="50"/>
                        </Path.RenderTransform>
                    </Path>

                     --><!--Left Arc--><!-- 
                    <Path StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F57F17" Offset="0.0" />
                                <GradientStop Color="#BF1F3F" Offset="1.0" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="50,90" IsClosed="False">
                                    <ArcSegment Point="10,50"
                                                Size="40,40"
                                                SweepDirection="Clockwise"
                                                IsLargeArc="False"/>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                        <Path.RenderTransform>
                            <RotateTransform x:Name="rotateTransform2" CenterX="50" CenterY="50"/>
                        </Path.RenderTransform>
                    </Path>
                </Canvas>

                 --><!--Loading Text with Animated Dots--><!-- 
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                     --><!--Static "Loading" text--><!-- 
                    <TextBlock Text="Loading"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                     --><!--Dot 1--><!-- 
                    <TextBlock x:Name="dot1"
                               Text="."
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="1" Duration="0:0:0.5" AutoReverse="True"
                                            BeginTime="0:0:0" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                     --><!--Dot 2--><!-- 
                    <TextBlock x:Name="dot2"
                               Text="."
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="1" Duration="0:0:0.5" AutoReverse="True"
                                            BeginTime="0:0:0.5" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>

                     --><!--Dot 3--><!-- 
                    <TextBlock x:Name="dot3"
                               Text="."
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="Opacity"
                                            From="0" To="1" Duration="0:0:0.5" AutoReverse="True"
                                            BeginTime="0:0:1" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>-->







    <!-- design no 3 -->

    <Grid Background="#80000000">
        <Canvas x:Name="LoaderCanvas" Width="180" Height="180">
            <!-- Center Block -->
            <Rectangle Width="30" Height="30" Fill="#0A56C4" Canvas.Left="75" Canvas.Top="75" RadiusX="8" RadiusY="8"/>

            <!-- Outer Blocks -->
            <Rectangle x:Name="Block0" Width="30" Height="30" Fill="#0A56C4" Canvas.Left="43" Canvas.Top="43" RadiusX="8" RadiusY="8"/>
            <Rectangle x:Name="Block1" Width="30" Height="30" Fill="#BF1F3F" Canvas.Left="75" Canvas.Top="43" RadiusX="8" RadiusY="8"/>
            <Rectangle x:Name="Block2" Width="30" Height="30" Fill="#0A56C4" Canvas.Left="107" Canvas.Top="43" RadiusX="8" RadiusY="8"/>
            <Rectangle x:Name="Block3" Width="30" Height="30" Fill="#0A56C4" Canvas.Left="107" Canvas.Top="75" RadiusX="8" RadiusY="8"/>
            <Rectangle x:Name="Block4" Width="30" Height="30" Fill="#BF1F3F" Canvas.Left="107" Canvas.Top="107" RadiusX="8" RadiusY="8"/>
            <Rectangle x:Name="Block5" Width="30" Height="30" Fill="#0A56C4" Canvas.Left="75" Canvas.Top="107" RadiusX="8" RadiusY="8"/>
            <Rectangle x:Name="Block6" Width="30" Height="30" Fill="#0A56C4" Canvas.Left="43" Canvas.Top="107" RadiusX="8" RadiusY="8"/>
            <Rectangle x:Name="Block7" Width="30" Height="30" Fill="#BF1F3F" Canvas.Left="43" Canvas.Top="75" RadiusX="8" RadiusY="8"/>


            <Canvas.Triggers>
                <EventTrigger RoutedEvent="Canvas.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            
                            <!-- OUTWARD MOVEMENT (1s, starts at 1s) -->
                            <DoubleAnimation Storyboard.TargetName="Block0" Storyboard.TargetProperty="(Canvas.Left)" To="30" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block0" Storyboard.TargetProperty="(Canvas.Top)" To="30" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block1" Storyboard.TargetProperty="(Canvas.Top)" To="30" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block2" Storyboard.TargetProperty="(Canvas.Left)" To="120" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block2" Storyboard.TargetProperty="(Canvas.Top)" To="30" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block3" Storyboard.TargetProperty="(Canvas.Left)" To="120" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block4" Storyboard.TargetProperty="(Canvas.Left)" To="120" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block4" Storyboard.TargetProperty="(Canvas.Top)" To="120" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block5" Storyboard.TargetProperty="(Canvas.Top)" To="120" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block6" Storyboard.TargetProperty="(Canvas.Left)" To="30" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block6" Storyboard.TargetProperty="(Canvas.Top)" To="120" Duration="0:0:0.5" BeginTime="0:0:0.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block7" Storyboard.TargetProperty="(Canvas.Left)" To="30" Duration="0:0:0.5" BeginTime="0:0:0.5"/>

                            <!-- ANTI-CLOCKWISE ROTATION (1s, starts at 2s) -->
                            <DoubleAnimation Storyboard.TargetName="Block0" Storyboard.TargetProperty="(Canvas.Left)" To="30" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block0" Storyboard.TargetProperty="(Canvas.Top)" To="75" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block7" Storyboard.TargetProperty="(Canvas.Left)" To="30" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block7" Storyboard.TargetProperty="(Canvas.Top)" To="120" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block6" Storyboard.TargetProperty="(Canvas.Left)" To="75" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block6" Storyboard.TargetProperty="(Canvas.Top)" To="120" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block5" Storyboard.TargetProperty="(Canvas.Left)" To="120" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block5" Storyboard.TargetProperty="(Canvas.Top)" To="120" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block4" Storyboard.TargetProperty="(Canvas.Left)" To="120" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block4" Storyboard.TargetProperty="(Canvas.Top)" To="75" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block3" Storyboard.TargetProperty="(Canvas.Left)" To="120" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block3" Storyboard.TargetProperty="(Canvas.Top)" To="30" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block2" Storyboard.TargetProperty="(Canvas.Left)" To="75" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block2" Storyboard.TargetProperty="(Canvas.Top)" To="30" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block1" Storyboard.TargetProperty="(Canvas.Left)" To="30" Duration="0:0:0.5" BeginTime="0:0:1"/>
                            <DoubleAnimation Storyboard.TargetName="Block1" Storyboard.TargetProperty="(Canvas.Top)" To="30" Duration="0:0:0.5" BeginTime="0:0:1"/>

                            <!-- MOVE BACK INWARD (TO REPLACED POSITION, starts at 3s) -->
                            <DoubleAnimation Storyboard.TargetName="Block0" Storyboard.TargetProperty="(Canvas.Left)" To="43" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block0" Storyboard.TargetProperty="(Canvas.Top)" To="75" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block1" Storyboard.TargetProperty="(Canvas.Left)" To="43" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block1" Storyboard.TargetProperty="(Canvas.Top)" To="43" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block2" Storyboard.TargetProperty="(Canvas.Left)" To="75" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block2" Storyboard.TargetProperty="(Canvas.Top)" To="43" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block3" Storyboard.TargetProperty="(Canvas.Left)" To="107" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block3" Storyboard.TargetProperty="(Canvas.Top)" To="43" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block4" Storyboard.TargetProperty="(Canvas.Left)" To="107" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block4" Storyboard.TargetProperty="(Canvas.Top)" To="75" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block5" Storyboard.TargetProperty="(Canvas.Left)" To="107" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block5" Storyboard.TargetProperty="(Canvas.Top)" To="107" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block6" Storyboard.TargetProperty="(Canvas.Left)" To="75" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block6" Storyboard.TargetProperty="(Canvas.Top)" To="107" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block7" Storyboard.TargetProperty="(Canvas.Left)" To="43" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetName="Block7" Storyboard.TargetProperty="(Canvas.Top)" To="107" Duration="0:0:0.5" BeginTime="0:0:1.5"/>

                            <DoubleAnimation Storyboard.TargetName="Block0" Storyboard.TargetProperty="Opacity" From="1" To="1" Duration="0:0:0.5" BeginTime="0:0:2" />
                            
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Canvas.Triggers>
        </Canvas>
    </Grid>





</Window>
