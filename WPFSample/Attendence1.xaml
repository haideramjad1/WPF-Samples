<Window x:Class="WPFSample.Attendence1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFSample"
        mc:Ignorable="d"
        Title="Attendence1" Height="520" Width="800"
        WindowState="Maximized"
        WindowStyle="None"
        Loaded="Window_Loaded">

    <Grid Background="White">

        <!-- Header Section -->
        <Border Background="#0A56C4" Height="50" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="00" Foreground="White" FontSize="24" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <Grid Grid.Column="2">
                    <Button x:Name="Close_Btn" 
                            Template="{StaticResource ImageButtonTemplate}"
                            Tag="{StaticResource CloseButtonImageBrush}"
                            Margin="3"
                            Click="Close_Btn_Click">
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Margin="0,50,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="0.7*"/>
                <RowDefinition Height="0.2*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height=".2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height=".2*"/>
            </Grid.RowDefinitions>

            <!-- Verification Section -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <RadioButton x:Name="pin_radioButton" 
                     Content="Verify Through Pin" 
                     GroupName="VerificationMethod"
                     IsChecked="True" 
                     Style="{StaticResource BigRadioButtonStyle}" 
                     Checked="pin_radioButton_Checked"/>

                    <RadioButton x:Name="card_radioButton" 
                     Content="Verify Through Card" 
                     GroupName="VerificationMethod"
                     Margin="30,0,0,0" 
                     Style="{StaticResource BigRadioButtonStyle}" 
                     Checked="card_radioButton_Checked"/>
                    
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" MaxWidth="600">

                    <TabControl x:Name="Pin_Tabs" BorderThickness="0">

                        <TabControl.Resources>
                            <Style TargetType="TabControl">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabControl">
                                            <ContentPresenter ContentSource="SelectedContent" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        
                        <TabItem Header="Tab 1" x:Name="Pin_Tab">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="1">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width=".3*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">

                                        <TextBlock x:Name="Pin_Label" Text="Pin :" Style="{StaticResource LeftAlignedTextBlock}" Margin="5,-100,0,0"> 
                                            
                                        </TextBlock>
                                        
                                        <TextBox x:Name="Pin_TextEdit"
                                        Style="{StaticResource CommonTextBoxStyle}" Margin="5,10"
                                        Visibility="Hidden" Height="50">
                                        </TextBox>

                                        <PasswordBox x:Name="Pin_Password"
                                            Style="{StaticResource CommonPasswordBoxStyle}" Margin="5,10" Height="50"> 
                                        </PasswordBox>
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <Button x:Name="EyeButton" 
                                                Style="{StaticResource LogInImageButtonStyle}"
                                                Tag="{StaticResource ClosedEyeImageBrush}"
                                                Height="auto" Width="auto" MaxHeight="70" MaxWidth="70"
                                                Click="EyeButton_Click">
                                        </Button>
                                    </Grid>

                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Tab 1" x:Name="Card_Tab">
                            <!-- Scanner Image Section -->
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="10" HorizontalAlignment="Center">
                                <StackPanel>
                                    <Image x:Name="Scan_Image"/>
                                    <!--Source="/Resources/Magnifier.png" />-->
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                    
                </Grid>

                <Grid Grid.Column="2" MaxWidth="600">

                    <UniformGrid Grid.Row="2" Columns="3" Rows="4" Margin="20,10,0,10" HorizontalAlignment="Stretch">
                        <Button Content="1" Style="{StaticResource NumericButtonStyle}" 
                    Background="#08449A" Margin="3"/>
                        <Button Content="2" Style="{StaticResource NumericButtonStyle}" 
                    Background="#08449A" Margin="3"/>
                        <Button Content="3" Style="{StaticResource NumericButtonStyle}" 
                    Background="#08449A" Margin="3"/>
                        <Button Content="4" Style="{StaticResource NumericButtonStyle}"
                    Background="#08449A" Margin="3"/>
                        <Button Content="5" Style="{StaticResource NumericButtonStyle}"
                    Background="#08449A" Margin="3"/>
                        <Button Content="6" Style="{StaticResource NumericButtonStyle}" 
                    Background="#08449A" Margin="3"/>
                        <Button Content="7" Style="{StaticResource NumericButtonStyle}" 
                    Background="#08449A" Margin="3"/>
                        <Button Content="8" Style="{StaticResource NumericButtonStyle}" 
                    Background="#08449A" Margin="3"/>
                        <Button Content="9" Style="{StaticResource NumericButtonStyle}" 
                    Background="#08449A" Margin="3"/>
                        <Button Content="Reset" Style="{StaticResource RedButtonStyle}" FontSize="25" FontWeight="Bold" MinWidth="100" Margin="3"/>
                        <Button Content="0" Style="{StaticResource NumericButtonStyle}" 
                    Background="#08449A" Margin="3"/>
                        <Button Content="Submit" Style="{StaticResource GreenButtonStyle}" FontSize="25" FontWeight="Bold" MinWidth="110" Margin="3"/>
                    </UniformGrid>
                </Grid>
            </Grid>

            <Grid Grid.Row="4">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >

                    <Button Content="Clock In" 
                Style="{StaticResource ManagerBlueButtonStyle}" MinWidth="150" MaxHeight="100"/>

                    <Button Content="Break In" 
                Style="{StaticResource ManagerBlueButtonStyle}" MinWidth="150" MaxHeight="100"/>

                    <Button Content="Break Out" 
                Style="{StaticResource ManagerBlueButtonStyle}" MinWidth="150" MaxHeight="100"/>

                    <Button Content="Clock Out" 
                Style="{StaticResource ManagerBlueButtonStyle}" MinWidth="150" MaxHeight="100"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>
