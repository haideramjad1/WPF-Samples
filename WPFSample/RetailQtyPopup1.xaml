<Window x:Class="WPFSample.RetailQtyPopup1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFSample"
        mc:Ignorable="d"
        Title="RetailQtyPopup1" Height="450" Width="500"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <Border CornerRadius="10">
        <Border CornerRadius="15"
            Background="White"
            BorderThickness ="20">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5297E0 " Offset="0"/>
                    <GradientStop Color="#273F6A " Offset="0.5"/>
                    <GradientStop Color="#A3DFFF  " Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Name="TitleTextBlock" 
                               Text="Sale Edit" 
                               FontSize="30"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5" 
                                  ShadowDepth="5" 
                                  Direction="270" 
                                  Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                </Grid>
                
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height=".5*"/>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height=".5*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Column="2"
                          Grid.Row="0">
                        <TextBlock Name="QTYLabelTextBlock" 
                                   Text="Quantity :" 
                                   FontSize="30"
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                        </TextBlock>
                    </Grid>
                    
                    <Grid Grid.Column="1"
                          Grid.Row="1">
                        <Button x:Name="QTYSubtract" Content="QTY -"
                                Style="{StaticResource BlueButtonStyle}">
                        </Button>
                        
                    </Grid>
                    
                    <Grid Grid.Column="2"
                          Grid.Row="1">
                            <TextBox x:Name="QTY_TextEdit"
                                       Style="{StaticResource CommonTextBoxStyle}" Margin="10,0,10,0"
                                       TextChanged="ForPlaceHolder_TextChanged">
                            </TextBox>

                        <TextBlock Name="QTYTextBlock" 
                                         Text="QTY" 
                                         Style="{StaticResource PlaceholderTextBlockStyle}"
                                       HorizontalAlignment="Center">
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Column="3"
                          Grid.Row="1">
                        <Button x:Name="QTYAdd" Content="QTY +"
                                Style="{StaticResource BlueButtonStyle}">

                        </Button>
                    </Grid>

                    <Grid Grid.Column="2"
                            Grid.Row="3">
                        <TextBlock Name="UPRLabelTextBlock" 
                                   Text="Unit Price :" 
                                   FontSize="30"
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="4" 
                          Grid.Column="2">
                            <TextBox x:Name="UPR_TextEdit"
                                   Style="{StaticResource CommonTextBoxStyle}" Margin="10,0,10,0"
                                   TextChanged="ForPlaceHolder_TextChanged">
                            </TextBox>

                        <TextBlock Name="UPRTextBlock" 
                                 Text="UPR" 
                                 Style="{StaticResource PlaceholderTextBlockStyle}"
                                   HorizontalAlignment="Center">
                        </TextBlock>
                    </Grid>

                </Grid>
                
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1">
                        <Button x:Name="Void" Content="Void"
                                Style="{StaticResource RedButtonStyle}">
                        </Button>
                    </Grid>
                    
                    <Grid Grid.Column="3">
                        <Button x:Name="Cancel" Content="Cancel"
                                Style="{StaticResource RedButtonStyle}">
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

        </Border>
    </Border>
</Window>
