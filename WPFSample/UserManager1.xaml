<Window x:Class="WPFSample.UserManager1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFSample"
        mc:Ignorable="d"
        Title="UserManager1" Width="850"
        SizeToContent="Height"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <Border>
        <Grid>
            <Border CornerRadius="10"
                BorderThickness ="10"
                Height="150"
                VerticalAlignment="Top"
                BorderBrush="LightGray"
                Background="#003187">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Column="0"
                      Width="45"
                      Margin="0,4,0,0"
                      Grid.Row="0">
                        <!--<Image x:Name="FormPicture" 
               Source="pack://application:,,,/Resources/Search_Product_Image.png"/>-->

                    </Grid>

                    <Grid Grid.Column="2" Grid.Row="0">
                        <Button x:Name="Close_Button" 
                            Margin="0,3,3,8"
                            Template="{StaticResource ImageButtonTemplate}"
                            Tag="{StaticResource CloseButtonImageBrush}"
                            Click="Close_Button_Click">
                        </Button>
                    </Grid>

                    <Grid Grid.Column="1" Grid.Row="0">
                        <Border CornerRadius="10">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                            </Border.Effect>

                            <Grid >
                                <TextBlock x:Name="FormTitle" 
                                       Text="User Manager"
                                       FontSize="30" 
                                       Padding="5,0,0,0"
                                       FontWeight="Medium"
                                       Foreground="White"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center">
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border CornerRadius="30" 
                    Background="White"
                    Margin="25,70,25,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="1" />
                </Border.Effect>

                <UniformGrid x:Name="ButtonGrid"
                             Columns="4"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             Margin="10">

                    <Button x:Name="NoBtn1" Content="Close" Style="{StaticResource ManagerRedButtonStyle}"/>
                    <Button x:Name="NoBtn2" Content="Close" Style="{StaticResource ManagerBlueButtonStyle}"/>
                    <Button x:Name="NoBtn3" Content="Close" Style="{StaticResource ManagerGreenButtonStyle}"/>
                    <Button x:Name="NoBtn4" Content="Close" Style="{StaticResource DarkBlueButtonStyle}"/>
                    <Button x:Name="NoBtn5" Content="Close" Style="{StaticResource OrangeButtonStyle}"/>
                    <Button x:Name="NoBtn6" Content="Close" Style="{StaticResource ManagerRedButtonStyle}"/>
                    <Button x:Name="NoBtn7" Content="Close" Style="{StaticResource ManagerBlueButtonStyle}"/>
                    <Button x:Name="NoBtn8" Content="Close" Style="{StaticResource ManagerGreenButtonStyle}"/>
                    <Button x:Name="NoBtn9" Content="Close" Style="{StaticResource DarkBlueButtonStyle}"/>
                    <Button x:Name="NoBtn10" Content="Close" Style="{StaticResource OrangeButtonStyle}"/>
                    <Button x:Name="NoBtn11" Content="Close" Style="{StaticResource ManagerRedButtonStyle}"/>
                    <Button x:Name="NoBtn12" Content="Close" Style="{StaticResource ManagerBlueButtonStyle}"/>
                    <Button x:Name="NoBtn13" Content="Close" Style="{StaticResource ManagerGreenButtonStyle}"/>
                    <Button x:Name="NoBtn14" Content="Close" Style="{StaticResource DarkBlueButtonStyle}"/>
                    <Button x:Name="NoBtn15" Content="Close" Style="{StaticResource OrangeButtonStyle}"/>
                    <Button x:Name="NoBtn16" Content="Close" Style="{StaticResource ManagerRedButtonStyle}"/>
                    <Button x:Name="NoBtn17" Content="Close" Style="{StaticResource ManagerBlueButtonStyle}"/>
                    <Button x:Name="NoBtn18" Content="Close" Style="{StaticResource ManagerGreenButtonStyle}"/>
                    <Button x:Name="NoBtn19" Content="Close" Style="{StaticResource DarkBlueButtonStyle}"/>
                </UniformGrid>

            </Border>
            
        </Grid>
    </Border>
</Window>
