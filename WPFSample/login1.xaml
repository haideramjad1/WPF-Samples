<Window x:Class="WPFSample.login1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFSample"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        mc:Ignorable="d"
        Title="login1" Height="750" Width="900"
        WindowStyle="None"
        WindowState="Maximized">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="40" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="250"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Button x:Name="Attendance_Btn" 
                        Content="Attendance Screen"
                        Style="{StaticResource NumericButtonStyle}"
                        FontSize="25"
                        Margin="0,0,0,-20"
                        Click="Attendance_Btn_Click">
                </Button>
            </Grid>
            
            <Grid Grid.Column="3">
                <Button x:Name="Close_Btn" 
                    Template="{StaticResource ImageButtonTemplate}"
                    Tag="{StaticResource CloseButtonImageBrush}"
                    Click="Close_Button_Click">
                </Button>
            </Grid>

        </Grid>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1">
                <Grid VerticalAlignment="Center">
                    <StackPanel Width="400"
                                Margin="0,80,0,0"
                            Orientation="Vertical">

                        <Image x:Name="pictureEdit" 
                               Source="/Resources/2222crop 1.png"
                            Height="400"/>

                        <TextBlock x:Name="LocationName_Label"
                               Text="Grocery Store"
                               Foreground="MidnightBlue"
                               FontSize="40"
                               FontWeight="Medium"
                               FontFamily="Times New Roman"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               Margin="50,20,0,0 "/>

                        <TextBlock x:Name="Version_Label"
                               Text="Grocery Store"
                               Foreground="MidnightBlue"
                               FontSize="40"
                               FontWeight="Medium"
                               FontFamily="Times New Roman"
                               TextWrapping="Wrap"
                               TextAlignment="Left"
                               Margin="50,20,0,0 "/>

                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2"
                  Margin="0,0,10,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="10" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1">
                    <CheckBox x:Name="PinLogin_CheckEdit" 
                              Content="Login Through Pin" 
                              Checked="PinLogin_CheckEdit_Checked"
                              Unchecked="PinLogin_CheckEdit_Unchecked"
                              Style="{StaticResource BigCheckBoxStyle}"
                              FontWeight="Medium"
                              Margin="5,0,0,0"/>
                </Grid>

                <Grid Grid.Row="2">
                    <TextBox x:Name="UserID_TextEdit"
                                Style="{StaticResource CommonTextBoxStyle}" Margin="5,0,5,0"
                                TextChanged="ForPlaceHolder_TextChanged"
                                MouseDoubleClick="Alphabetic_Keyboard_Click">
                    </TextBox>

                    <TextBlock x:Name="UserID_Label" 
                               Text="User ID :"
                               Style="{StaticResource RightAlignedTextBlock}" 
                               Height="31"
                               Margin="-400,0,430,0">
                    </TextBlock>

                </Grid>
                
                <Grid Grid.Row="3">
                    <TextBox x:Name="Pin_TextEdit"
                                Style="{StaticResource CommonTextBoxStyle}" Margin="5,0,5,0"
                                TextChanged="ForPlaceHolder_TextChanged"
                                MouseDoubleClick="Alphabetic_Keyboard_Click">
                    </TextBox>

                    <TextBlock x:Name="UserPin_Label" 
                               Text="Pin :"
                               Style="{StaticResource RightAlignedTextBlock}" 
                               Height="31"
                               Margin="-400,0,430,0">
                    </TextBlock>
                    
                    <Button x:Name="EyeButton" 
                            Style="{StaticResource LogInImageButtonStyle}"
                            Tag="{StaticResource ClosedEyeImageBrush}"
                            Margin="360,0,0,0"
                            Height="40" Width="45"
                            Click="EyeButton_Click">
                    </Button>

                </Grid>

                <Grid Grid.Row="4"
                      Margin="0,10,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="110" />
                        <RowDefinition Height="110" />
                        <RowDefinition Height="110" />
                        <RowDefinition Height="110" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions >
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Button_1" Style="{StaticResource NumericButtonStyle}" Content="1" Grid.Row="0" Grid.Column="0" />
                    <Button x:Name="Button_2" Style="{StaticResource NumericButtonStyle}" Content="2" Grid.Row="0" Grid.Column="1" />
                    <Button x:Name="Button_3" Style="{StaticResource NumericButtonStyle}" Content="3" Grid.Row="0" Grid.Column="2" />
                    <Button x:Name="Button_4" Style="{StaticResource NumericButtonStyle}" Content="4" Grid.Row="1" Grid.Column="0" />
                    <Button x:Name="Button_5" Style="{StaticResource NumericButtonStyle}" Content="5" Grid.Row="1" Grid.Column="1" />
                    <Button x:Name="Button_6" Style="{StaticResource NumericButtonStyle}" Content="6" Grid.Row="1" Grid.Column="2" />
                    <Button x:Name="Button_7" Style="{StaticResource NumericButtonStyle}" Content="7" Grid.Row="2" Grid.Column="0" />
                    <Button x:Name="Button_8" Style="{StaticResource NumericButtonStyle}" Content="8" Grid.Row="2" Grid.Column="1" />
                    <Button x:Name="Button_9" Style="{StaticResource NumericButtonStyle}" Content="9" Grid.Row="2" Grid.Column="2" />
                    <Button x:Name="Button_Clear" Style="{StaticResource NumericButtonStyle}" Content="x" Grid.Row="3" Grid.Column="0" />
                    <Button x:Name="Button_0" Style="{StaticResource NumericButtonStyle}" Content="0" Grid.Row="3" Grid.Column="1" />
                    <Button x:Name="Button_Go" Style="{StaticResource NumericButtonStyle}" Content="Go" Grid.Row="3" Grid.Column="2" />

                </Grid>

            </Grid>

        </Grid>

    </Grid>
</Window>
